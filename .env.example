# Toggl Focus (Toggl 2.0) API key
# Create one at https://focus.toggl.com/settings
# Toggl keeps a single active key per user: creating a new key revokes the previous one.
TOGGL_API_KEY=toggl_sk_your_api_key_here

# Optional. The organization and workspace are discovered from the API; set these
# only to pin the server to a specific scope.
# TOGGL_ORGANIZATION_ID=
# TOGGL_WORKSPACE_ID=
